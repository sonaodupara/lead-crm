DOMAIN=service.example.com
POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=change-me-another-long-random-string-at-least-32-chars
UPLOAD_DIR=/data/uploads

# Zoho (India data centre). Leave client id/secret/org blank to run with sync off.
# Client id + secret alone is enough (no refresh token). Keep the secret only here.
ZOHO_PRODUCT=books
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_POS_API_URL=https://api.zakya.in
ZOHO_BOOKS_API_URL=https://www.zohoapis.in/books/v3
# Your own state code as Zoho writes it (Kerala is KL); sales to another state use IGST
HOME_PLACE_OF_SUPPLY=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
# Wrap the JSON in single quotes, e.g. '{"invoice.cf_warranty_start":"123"}'
ZOHO_CUSTOM_FIELD_IDS='{}'
