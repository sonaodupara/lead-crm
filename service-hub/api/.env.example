NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/servicehub
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# Zoho (India data centre). Leave blank to run with sync off.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_BOOKS_API_URL=https://www.zohoapis.in/books/v3
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
# After creating the custom fields in Zoho (docs/ZOHO.md), map them: {"invoice.cf_warranty_start":"<customfield_id>", ...}
ZOHO_CUSTOM_FIELD_IDS={}
